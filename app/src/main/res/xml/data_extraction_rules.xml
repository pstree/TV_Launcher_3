<?xml version="1.0" encoding="utf-8"?>
<!--
  Only the launcher's own settings (the pinned home-screen shortcuts, stored as a DataStore file)
  are worth carrying over. Everything else is excluded.
-->
<data-extraction-rules>
    <cloud-backup>
        <include
            domain="file"
            path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include
            domain="file"
            path="datastore/" />
    </device-transfer>
</data-extraction-rules>
